# Copy to .env and fill in real values. Never commit .env.

# CockroachDB connection string, asyncpg driver.
# CockroachDB Cloud serverless example (get from the cluster's "Connect" panel):
#   postgresql+asyncpg://<user>:<password>@<host>:26257/<database>?sslmode=require
# Note: use sslmode=require here, not verify-full — asyncpg needs a local CA bundle
# for verify-full and it's unnecessary for a dev cluster.
DATABASE_URL=postgresql+asyncpg://user:password@host:26257/defaultdb?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Groq API key for LLM agents (JD Parser, Email Drafter, Resume Parser).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=change-me

# Cloudflare R2 (S3-compatible object storage) — stores resume PDFs.
# Dashboard: R2 Object Storage -> Manage API tokens -> Create API token (Object Read & Write).
# Account ID is shown on the R2 overview page (right sidebar).
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=change-me
