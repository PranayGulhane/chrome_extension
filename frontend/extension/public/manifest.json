{
  "manifest_version": 3,
  "name": "LinkedIn Job Outreach Assistant",
  "version": "0.1.0",
  "description": "AI-assisted cold outreach for LinkedIn hiring posts.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:8123/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Job Outreach Assistant (Alt+J)"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Toggle the floating outreach panel"
    }
  }
}
